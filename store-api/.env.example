# NestKart Store API configuration template
# Copy to store-api/.env and replace placeholder secrets before production/live runs.

DEMO_MODE=true
DATABASE_URL=sqlite:///data/store.db
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_ISSUER=nestkart-store
AGENT_WEBHOOK_URL=http://localhost:8001/v1/webhooks/store
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152

# Required shared secrets (must match agent/.env WEBHOOK_SECRET and STORE_*_CLIENT_SECRET)
WEBHOOK_SECRET=replace-me
SERVICE_CLIENT_SECRETS={"agent-executor":"replace-me","agent-monitor":"replace-me"}

