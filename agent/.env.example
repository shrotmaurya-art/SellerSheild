STORE_BASE_URL=http://localhost:8000
STORE_JWKS_URL=http://localhost:8000/.well-known/jwks.json
STORE_MODE=fixtures
DATABASE_URL=sqlite:///data/agent.db
DEV_MODE=true
CORS_ORIGINS=[]

# Store service client credentials
STORE_EXECUTOR_CLIENT_ID=replace-me
STORE_EXECUTOR_CLIENT_SECRET=replace-me
STORE_MONITOR_CLIENT_ID=replace-me
STORE_MONITOR_CLIENT_SECRET=replace-me
WEBHOOK_SECRET=replace-me

# LLM Providers (optional for now)
LLM_PRIMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_PRIMARY_API_KEY=replace-me
LLM_PRIMARY_MODEL=gemini-2.5-flash
LLM_SECONDARY_BASE_URL=https://api.groq.com/openai/v1
LLM_SECONDARY_API_KEY=replace-me
LLM_SECONDARY_MODEL=llama-3.3-70b-versatile
LLM_TERTIARY_BASE_URL=https://openrouter.ai/api/v1
LLM_TERTIARY_API_KEY=replace-me
LLM_TERTIARY_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_TIMEOUT_S=12
LLM_CACHE_MODE=off
PROMPT_VERSION=v1

